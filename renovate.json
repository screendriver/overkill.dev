{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": ["github>enormora/renovate-config#1.0.4", "github>enormora/renovate-config:renovate-automerge#1.0.4"],
	"commitMessagePrefix": "",
	"dependencyDashboard": true,
	"packageRules": [
		{
			"matchManagers": ["woodpecker"],
			"matchPackageNames": ["node"],
			"enabled": false
		},
		{
			"groupName": "Fontsource dependencies",
			"groupSlug": "fontsource-dependencies",
			"matchPackageNames": ["@fontsource/*"]
		},
		{
			"groupName": "Node.js",
			"groupSlug": "nodejs",
			"matchPackageNames": ["node"],
			"automerge": false
		}
	],
	"customManagers": [
		{
			"customType": "regex",
			"managerFilePatterns": ["/^\\.woodpecker\\/deploy\\.yaml$/", "/^\\.woodpecker\\/test\\.yaml$/"],
			"matchStrings": ["image:\\s*node:(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
			"depNameTemplate": "node",
			"datasourceTemplate": "node",
			"versioningTemplate": "node"
		}
	]
}
